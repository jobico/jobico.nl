---
const services = [
  {
    title: 'Virtual environment',
    description: 'Troubleshooting, maintenance and optimisation of virtual environments. From root-cause diagnosis to structural, lasting solutions.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    tag: 'Infrastructure',
  },
  {
    title: 'Citrix support',
    description: 'End-to-end support for Citrix environments, from initial installation and configuration through to day-to-day management and troubleshooting.',
    icon: `<img src="/icons/citrix.svg" alt="Citrix" width="26" height="26" style="display:block;" />`,
    tag: 'Citrix',
  },
  {
    title: 'Image deployment',
    description: 'Automation of virtual image deployment pipelines. Efficient, reproducible and scalable, regardless of environment size.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    tag: 'Automation',
  },
  {
    title: 'Citrix NetScaler',
    description: 'Configuration, management and troubleshooting of Citrix NetScaler (ADC). Load balancing, SSL offloading, content switching and more.',
    icon: `<img src="/icons/netscaler.png" alt="NetScaler" width="36" height="36" style="display:block; object-fit:contain;" />`,
    tag: 'ADC',
  },
  {
    title: 'VDI & Automation',
    description: 'Design, deployment and automation of Virtual Desktop Infrastructure. From Citrix provisioning to fully scripted image pipelines — built to be reproducible, scalable and maintainable.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    tag: 'EUC',
  },
  {
    title: 'Scripting & Community',
    description: 'PowerShell scripts and tools for IT management. I share knowledge through my technical blog and actively contribute to the community.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><path d="M4 17l6-6-6-6"/><path d="M12 19h8"/></svg>`,
    tag: 'Scripting',
  },
];
---

<section id="services" style="padding: 7rem 1.5rem; background: white;">
  <div style="max-width: 1100px; margin: 0 auto;">

    <div style="max-width: 560px; margin-bottom: 4rem;">
      <p class="section-label reveal" style="margin-bottom: 1.5rem;">Services</p>
      <h2 class="reveal reveal-delay-1" style="font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; margin-bottom: 1rem;">
        What I can do<br/><span style="color: var(--color-navy);">for you</span>
      </h2>
      <p class="reveal reveal-delay-2" style="line-height: 1.8;">
        From day-to-day management to complex migrations, I deliver pragmatic IT solutions
        with deep knowledge of virtual workplace environments.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
      {services.map((service, i) => (
        <div class={`service-card reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="icon-wrap">
            <Fragment set:html={service.icon} />
          </div>
          <p style="font-family: var(--font-display); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-navy); margin-bottom: 0.75rem;">{service.tag}</p>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--color-prussian);">{service.title}</h3>
          <p style="font-size: 0.9rem; line-height: 1.7; color: var(--color-slate);">{service.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA strip -->
    <div class="reveal" style="
      margin-top: 4rem;
      background: var(--color-blizzard);
      border-radius: 1rem;
      padding: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
    ">
      <div>
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-prussian); margin-bottom: 0.4rem;">Have a specific need?</h3>
        <p style="color: var(--color-slate); font-size: 0.95rem;">Get in touch for a no-obligation conversation about your situation.</p>
      </div>
      <a href="/#contact" class="btn-primary">Send a message</a>
    </div>

  </div>
</section>

<style>
  @media (max-width: 900px) {
    #services > div > div:nth-child(3) {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 560px) {
    #services > div > div:nth-child(3) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
