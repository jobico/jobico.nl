---
const services = [
  {
    domain: 'Citrix',
    title: 'Citrix support',
    description: 'End-to-end support — installation, configuration, day-to-day management and troubleshooting of Citrix environments.',
  },
  {
    domain: 'ADC',
    title: 'NetScaler',
    description: 'Configuration, management and troubleshooting. Load balancing, SSL offloading, content switching.',
  },
  {
    domain: 'EUC',
    title: 'VDI & automation',
    description: 'Design, deployment and automation of Virtual Desktop Infrastructure — reproducible, scalable, maintainable.',
  },
  {
    domain: 'Automation',
    title: 'Image deployment',
    description: 'Automated image pipelines, efficient and reproducible regardless of environment size.',
  },
  {
    domain: 'Infrastructure',
    title: 'Virtual environments',
    description: 'Troubleshooting, maintenance and optimisation — from root-cause diagnosis to structural, lasting solutions.',
  },
  {
    domain: 'Scripting',
    title: 'PowerShell & community',
    description: 'Scripts and tooling for IT management, shared through my technical blog and community contributions.',
  },
];
---

<section id="services" style="padding: 6rem 0;">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 2rem;">

    <div class="sec-head reveal">
      <h2 style="font-size: clamp(1.9rem, 3.5vw, 2.6rem); letter-spacing: -0.035em;">What I do</h2>
      <span class="mono-note">Six disciplines, one consultant</span>
    </div>

    <div class="reveal reveal-delay-1">
      {services.map(service => (
        <a class="svc-row" href="/#contact">
          <span class="domain">{service.domain}</span>
          <span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    #services { padding: 4rem 0 !important; }
    .sec-head { flex-direction: column; gap: 0.5rem; margin-bottom: 2.5rem; }
  }
</style>
