---
// Microsoft Clarity — loaded on every page in cookieless "consent mode".
// Before the visitor accepts the analytics category, Clarity collects only
// generalized, cookieless data. Once analytics consent is granted (see
// CookieConsent.astro), we upgrade it to full tracking via the Consent API.
const CLARITY_PROJECT_ID = 'xho8b4qo7w';
---

<script is:inline define:vars={{ CLARITY_PROJECT_ID }}>
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', CLARITY_PROJECT_ID);

  // Start in cookieless mode: no first/third-party cookies until the visitor
  // grants the analytics category. We never use ad storage on this site.
  window.clarity('consentv2', {
    ad_Storage: 'denied',
    analytics_Storage: 'denied',
  });
</script>
