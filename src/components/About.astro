---
const now = new Date();
const itMonths = (now.getFullYear() - 2002) * 12 + (now.getMonth() - 5); // base: June 2002
const itYears = Math.floor(itMonths / 12);
---
<section id="about" class="about">
  <div class="about-wrap">

    <!-- Left: pull-quote + detail -->
    <div>
      <blockquote class="reveal">
        "I'd rather leave behind a documented pipeline <em>than a dependency on me.</em>"
      </blockquote>
      <div class="detail reveal reveal-delay-1">
        <p>
          Since 2010 I've worked in end-user computing: Citrix DaaS and on-prem, NetScaler,
          provisioning, Azure, and the PowerShell glue that holds enterprise environments together.
        </p>
        <p>
          Pragmatic over dogmatic. Everything I deliver is built to be maintained by your team —
          not just by its author. {itYears} years in IT, shared along the way at
          <a href="https://blog.j81.nl" target="_blank" rel="noopener">blog.j81.nl</a>.
        </p>
        <div class="meta">
          <span>15+ yrs EUC</span>
          <span>Citrix · NetScaler</span>
          <span>PowerShell · Terraform · Packer</span>
        </div>
      </div>
    </div>

    <!-- Right: terminal -->
    <div class="terminal reveal reveal-delay-2" aria-label="Terminal demo">
      <div class="term-bar">
        <i></i><i></i><i></i>
        <span class="title">Windows PowerShell — jobico.nl</span>
      </div>
      <div class="term-body" id="term"></div>
    </div>

  </div>
</section>

<style>
  .about {
    background: var(--color-prussian);
    color: rgba(178, 235, 242, 0.75);
    padding: 6rem 0;
  }
  .about-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about blockquote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .about blockquote em { font-style: normal; color: var(--color-aero); }
  .about .detail { margin-top: 2rem; }
  .about .detail p { margin-bottom: 1.2rem; font-size: 0.98rem; }
  .about .detail a {
    color: var(--color-aero);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about .meta {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(178, 235, 242, 0.18);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-shadow-soft);
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .about-wrap { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 640px) {
    .about { padding: 4rem 0; }
  }
</style>

<script>
  type Part = [string, string];
  interface Line { parts: Part[]; pause: number; }

  const lines: Line[] = [
    { parts: [['t-prompt', 'PS C:\\> '], ['t-cmd', 'Connect-Specialist '], ['t-param', '-Focus '], ['t-cmd', 'Citrix, EUC, Automation']], pause: 300 },
    { parts: [['t-ok', '  [OK] '], ['t-dim', '15+ years of EUC experience loaded.']], pause: 400 },
    { parts: [['t-prompt', 'PS C:\\> '], ['t-cmd', 'Invoke-Deployment '], ['t-param', '-Target '], ['t-cmd', "'YourEnvironment' "], ['t-param', '-Mode '], ['t-cmd', 'Pragmatic']], pause: 300 },
    { parts: [['t-ok', '  [OK] '], ['t-dim', 'Image pipeline: reproducible, scalable, documented.']], pause: 150 },
    { parts: [['t-ok', '  [OK] '], ['t-dim', 'Manual work: automated.']], pause: 400 },
    { parts: [['t-prompt', 'PS C:\\> '], ['t-cmd', 'Get-Contact']], pause: 200 },
    { parts: [['t-dim', '  -> '], ['t-cmd', 'info@jobico.nl']], pause: 0 },
  ];

  const term = document.getElementById('term');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function renderInstant() {
    if (!term) return;
    for (const line of lines) {
      const div = document.createElement('div');
      div.className = 't-line';
      for (const [cls, txt] of line.parts) {
        const s = document.createElement('span');
        s.className = cls;
        s.textContent = txt;
        div.appendChild(s);
      }
      term.appendChild(div);
    }
    const c = document.createElement('span');
    c.className = 'cursor';
    term.appendChild(c);
  }

  async function typeLines() {
    if (!term) return;
    const cursor = document.createElement('span');
    cursor.className = 'cursor';
    for (const line of lines) {
      const div = document.createElement('div');
      div.className = 't-line';
      term.appendChild(div);
      div.appendChild(cursor);
      const isOutput = line.parts[0][0] !== 't-prompt';
      for (const [cls, txt] of line.parts) {
        const s = document.createElement('span');
        s.className = cls;
        div.insertBefore(s, cursor);
        if (isOutput) {
          s.textContent = txt;
        } else {
          for (const ch of txt) {
            s.textContent += ch;
            await new Promise(r => setTimeout(r, 22 + Math.random() * 30));
          }
        }
      }
      await new Promise(r => setTimeout(r, line.pause));
    }
    term.appendChild(cursor);
  }

  let started = false;
  function start() {
    if (started || !term) return;
    started = true;
    reduced ? renderInstant() : typeLines();
  }

  if (reduced) {
    start();
  } else if (term) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { start(); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(term);
  }
</script>
