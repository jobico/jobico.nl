---
const eucYears = new Date().getFullYear() - 2010;
---
<header id="home" class="hero-section">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 2rem; width: 100%;">

    <p class="kicker reveal" style="display: block; margin-bottom: 2.4rem;">
      Freelance IT consultant — Citrix · EUC · Automation — Noord-Brabant, NL
    </p>

    <h1 class="reveal reveal-delay-1" style="
      font-size: clamp(3rem, 8.5vw, 7rem);
      line-height: 0.98;
      letter-spacing: -0.045em;
      max-width: 18ch;
    ">
      The virtual workplace, <span style="color: var(--color-navy);">without the manual work.</span>
    </h1>

    <div class="hero-foot reveal reveal-delay-2">
      <p class="lede">
        <strong>JOBICO is John Billekens.</strong> {eucYears}-plus years of Citrix, NetScaler
        and end-user computing, delivered as troubleshooting that finds root causes and
        automation that makes itself unnecessary.
      </p>
      <div class="cta-row">
        <a href="/#contact" class="btn-primary">Get in touch</a>
        <a href="/#services" class="btn-secondary">Services</a>
      </div>
    </div>

  </div>
</header>

<style>
  .hero-section {
    padding: 11rem 0 7rem;
  }
  .hero-section h1 {
    color: var(--color-prussian);
  }
  .hero-foot {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-hair);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-foot .lede {
    font-size: 1.1rem;
    font-weight: 300;
    max-width: 34rem;
  }
  .hero-foot .lede strong {
    color: var(--color-prussian);
    font-weight: 500;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .hero-foot { grid-template-columns: 1fr; gap: 2rem; }
    .cta-row { justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .hero-section { padding: 8rem 0 5rem; }
  }
</style>
