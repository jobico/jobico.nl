---
---
<section id="home" class="dot-grid" style="
  position: relative;
  background-color: var(--color-prussian);
  padding: 10rem 1.5rem 8rem;
  overflow: hidden;
  min-height: 100vh;
  display: flex;
  align-items: center;
">
  <!-- Decorative large faded logo mark -->
  <div aria-hidden="true" style="
    position: absolute;
    right: -4rem;
    top: 50%;
    transform: translateY(-50%);
    width: min(520px, 65vw);
    opacity: 0.07;
    pointer-events: none;
  ">
    <img src="/logo.png" alt="" style="width: 100%; height: auto; filter: brightness(0) invert(1);" />
  </div>

  <!-- Blue arc accents -->
  <div aria-hidden="true" style="
    position: absolute;
    top: -200px; right: -200px;
    width: 600px; height: 600px;
    border-radius: 50%;
    border: 1px solid rgba(107, 185, 232, 0.12);
    pointer-events: none;
  "></div>
  <div aria-hidden="true" style="
    position: absolute;
    top: -120px; right: -120px;
    width: 440px; height: 440px;
    border-radius: 50%;
    border: 1px solid rgba(107, 185, 232, 0.08);
    pointer-events: none;
  "></div>

  <div style="max-width: 1100px; margin: 0 auto; width: 100%; position: relative; z-index: 1;">
    <div style="max-width: 680px;">

      <p style="
        display: inline-block;
        font-family: var(--font-display);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-aero);
        border: 1px solid rgba(107,185,232,0.4);
        border-radius: 2rem;
        padding: 0.3rem 0.8rem;
        margin-bottom: 2rem;
      " class="reveal">Freelance IT Consultant · Noord-Brabant, NL</p>

      <h1 class="reveal reveal-delay-1" style="
        font-size: clamp(2.8rem, 6vw, 5rem);
        font-weight: 800;
        color: white;
        margin-bottom: 1.5rem;
        line-height: 1.05;
      ">
        Citrix. PowerShell.<br/>
        <span style="color: var(--color-aero);">Infrastructure as Code.</span>
      </h1>

      <p class="reveal reveal-delay-2" style="
        font-size: 1.15rem;
        color: rgba(178, 235, 242, 0.8);
        max-width: 520px;
        margin-bottom: 2.5rem;
        font-weight: 300;
        line-height: 1.7;
      ">
        Specialist in Citrix, EUC and IT automation. From troubleshooting virtual environments
        to writing PowerShell and building infrastructure as code. Complex problems, practical solutions.
        Automating what shouldn't be manual.
      </p>

      <div class="reveal reveal-delay-3" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
        <a href="/#contact" class="btn-primary">
          Get in touch
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/#services" class="btn-secondary-light">
          View services
        </a>
      </div>

      <!-- Stats row -->
      <div class="reveal reveal-delay-4" style="
        display: flex;
        flex-wrap: wrap;
        gap: 2.5rem;
        margin-top: 4rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(178,235,242,0.12);
      ">
        <div>
          <p style="font-family: var(--font-display); font-size: 2rem; font-weight: 800; color: white; line-height: 1;">16+</p>
          <p style="font-size: 0.8rem; color: rgba(178,235,242,0.6); margin-top: 0.25rem; letter-spacing: 0.05em;">years experience</p>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 2rem; font-weight: 800; color: white; line-height: 1;">Citrix</p>
          <p style="font-size: 0.8rem; color: rgba(178,235,242,0.6); margin-top: 0.25rem; letter-spacing: 0.05em;">expert</p>
        </div>
        <div>
          <p style="font-family: var(--font-display); font-size: 2rem; font-weight: 800; color: white; line-height: 1;">DevOps</p>
          <p style="font-size: 0.8rem; color: rgba(178,235,242,0.6); margin-top: 0.25rem; letter-spacing: 0.05em;">Infrastructure as Code</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Diagonal bottom cut -->
  <div style="
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 80px;
    background: var(--color-bg);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  "></div>
</section>
