---
interface RssPost {
  title: string;
  link: string;
  category: string;
}

function decodeEntities(str: string): string {
  return str
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&nbsp;/g, ' ');
}

let posts: RssPost[] = [];
let fetchFailed = false;

try {
  const res = await fetch('https://blog.j81.nl/feed', {
    headers: { 'User-Agent': 'jobico.nl/1.0 (RSS reader)' },
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) {
    const xml = await res.text();
    const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].slice(0, 3);
    posts = items.map(m => {
      const s = m[1];
      const title =
        s.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/s)?.[1] ??
        s.match(/<title>(.*?)<\/title>/s)?.[1] ??
        '';
      const link =
        s.match(/<link>\s*(https?:\/\/[^\s<]+)\s*<\/link>/)?.[1] ??
        s.match(/<guid[^>]*>\s*(https?:\/\/[^\s<]+)\s*<\/guid>/)?.[1] ??
        'https://blog.j81.nl';
      const category =
        s.match(/<category><!\[CDATA\[(.*?)\]\]><\/category>/s)?.[1] ??
        s.match(/<category>(.*?)<\/category>/s)?.[1] ??
        'Blog';
      return { title: decodeEntities(title.trim()), link: link.trim(), category: decodeEntities(category.trim()) };
    });
  }
} catch {
  fetchFailed = true;
}
---

<section id="blog" style="padding: 7rem 1.5rem; background: var(--color-bg);">
  <div style="max-width: 1100px; margin: 0 auto;">

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">

      <div>
        <p class="section-label reveal" style="margin-bottom: 1.5rem;">Blog</p>
        <h2 class="reveal reveal-delay-1" style="font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; margin-bottom: 1.25rem;">
          Sharing knowledge<br/><span style="color: var(--color-navy);">with the community</span>
        </h2>
        <p class="reveal reveal-delay-2" style="line-height: 1.8; margin-bottom: 1.5rem;">
          On my technical blog I publish in-depth articles about EUC, Citrix, PowerShell and Digital Workspace.
          Practical knowledge, built from years of hands-on experience in the field.
        </p>
        <p class="reveal reveal-delay-2" style="line-height: 1.8; margin-bottom: 2.5rem;">
          Alongside articles I publish scripts and tools that help IT professionals
          work more efficiently.
        </p>
        <div class="reveal reveal-delay-3" style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="https://blog.j81.nl" target="_blank" rel="noopener" class="btn-primary">
            Visit the blog
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3h7v7M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: live RSS card -->
      <div class="reveal reveal-delay-2">
        <div style="
          background: var(--color-prussian);
          border-radius: 1rem;
          overflow: hidden;
          box-shadow: 0 24px 60px rgba(10, 46, 80, 0.18);
        ">
          <!-- Browser chrome -->
          <div style="background: rgba(0,0,0,0.2); padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 0.6rem; height: 0.6rem; border-radius: 50%; background: rgba(255,255,255,0.2);"></div>
            <div style="width: 0.6rem; height: 0.6rem; border-radius: 50%; background: rgba(255,255,255,0.2);"></div>
            <div style="width: 0.6rem; height: 0.6rem; border-radius: 50%; background: rgba(255,255,255,0.2);"></div>
            <div style="flex: 1; background: rgba(255,255,255,0.06); border-radius: 0.25rem; padding: 0.25rem 0.75rem; margin-left: 0.5rem;">
              <p style="font-size: 0.7rem; color: rgba(178,235,242,0.5); font-family: var(--font-display); letter-spacing: 0.04em;">blog.j81.nl</p>
            </div>
          </div>

          <!-- Posts -->
          <div style="padding: 2rem;" class="dot-grid">
            <div style="position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1rem;">
              {posts.length > 0 ? posts.map(post => (
                <a
                  href={post.link}
                  target="_blank"
                  rel="noopener"
                  style="
                    background: rgba(255,255,255,0.04);
                    border: 1px solid rgba(178,235,242,0.1);
                    border-radius: 0.5rem;
                    padding: 1rem;
                    text-decoration: none;
                    display: block;
                    transition: background 0.2s, border-color 0.2s;
                  "
                  onmouseover="this.style.background='rgba(255,255,255,0.08)';this.style.borderColor='rgba(178,235,242,0.2)'"
                  onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.borderColor='rgba(178,235,242,0.1)'"
                >
                  <p style="font-size: 0.65rem; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-aero); margin-bottom: 0.4rem;">{post.category}</p>
                  <p style="font-family: var(--font-display); font-weight: 600; color: white; font-size: 0.85rem; line-height: 1.4;">{post.title}</p>
                </a>
              )) : (
                <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(178,235,242,0.1); border-radius: 0.5rem; padding: 1.5rem; text-align: center;">
                  <p style="color: rgba(178,235,242,0.5); font-family: var(--font-display); font-size: 0.875rem;">Visit blog.j81.nl for the latest articles.</p>
                </div>
              )}
              <a
                href="https://blog.j81.nl"
                target="_blank"
                rel="noopener"
                style="font-size: 0.75rem; color: rgba(178,235,242,0.35); text-align: center; padding-top: 0.5rem; font-family: var(--font-display); letter-spacing: 0.06em; text-decoration: none; transition: color 0.2s;"
                onmouseover="this.style.color='rgba(178,235,242,0.65)'"
                onmouseout="this.style.color='rgba(178,235,242,0.35)'"
              >
                All posts at blog.j81.nl →
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    #blog > div > div {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
  }
</style>
