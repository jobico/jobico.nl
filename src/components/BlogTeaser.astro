---
interface RssPost {
  title: string;
  link: string;
  category: string;
}

function decodeEntities(str: string): string {
  return str
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&nbsp;/g, ' ');
}

let posts: RssPost[] = [];
let fetchFailed = false;

try {
  const res = await fetch('https://blog.j81.nl/feed', {
    headers: { 'User-Agent': 'jobico.nl/1.0 (RSS reader)' },
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) {
    const xml = await res.text();
    const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].slice(0, 3);
    posts = items.map(m => {
      const s = m[1];
      const title =
        s.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/s)?.[1] ??
        s.match(/<title>(.*?)<\/title>/s)?.[1] ??
        '';
      const link =
        s.match(/<link>\s*(https?:\/\/[^\s<]+)\s*<\/link>/)?.[1] ??
        s.match(/<guid[^>]*>\s*(https?:\/\/[^\s<]+)\s*<\/guid>/)?.[1] ??
        'https://blog.j81.nl';
      const category =
        s.match(/<category><!\[CDATA\[(.*?)\]\]><\/category>/s)?.[1] ??
        s.match(/<category>(.*?)<\/category>/s)?.[1] ??
        'Blog';
      return { title: decodeEntities(title.trim()), link: link.trim(), category: decodeEntities(category.trim()) };
    });
  }
} catch {
  fetchFailed = true;
}
---

<section id="blog" style="padding: 6rem 0;">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 2rem;">

    <div class="sec-head reveal">
      <h2 style="font-size: clamp(1.9rem, 3.5vw, 2.6rem); letter-spacing: -0.035em;">From the blog</h2>
      <a href="https://blog.j81.nl" target="_blank" rel="noopener" class="mono-note blog-all">All posts at blog.j81.nl →</a>
    </div>

    <div class="reveal reveal-delay-1">
      {posts.length > 0 ? posts.map(post => (
        <a class="post-row" href={post.link} target="_blank" rel="noopener">
          <span class="domain">{post.category}</span>
          <span class="post-title">{post.title}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )) : (
        <p class="blog-empty">Visit blog.j81.nl for the latest articles.</p>
      )}
    </div>

  </div>
</section>

<style>
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
    gap: 1.5rem;
  }
  .blog-all { text-decoration: none; transition: color 0.2s; }
  .blog-all:hover { color: var(--color-prussian); }

  .post-row {
    display: grid;
    grid-template-columns: 9rem 1fr 2.5rem;
    gap: 2.5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-hair);
    text-decoration: none;
    transition: padding-left 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .post-row:last-of-type { border-bottom: 1px solid var(--color-hair); }
  .post-row:hover { padding-left: 1rem; }
  .post-row .domain {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-shadow);
  }
  .post-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--color-prussian);
  }
  .post-row .arrow {
    color: var(--color-aero);
    font-size: 1.3rem;
    justify-self: end;
    transition: color 0.2s, transform 0.25s;
  }
  .post-row:hover .arrow { color: var(--color-navy); transform: translateX(4px); }

  .blog-empty {
    padding: 1.9rem 0;
    border-top: 1px solid var(--color-hair);
    border-bottom: 1px solid var(--color-hair);
    color: var(--color-shadow);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .post-row { grid-template-columns: 1fr; gap: 0.4rem; }
    .post-row .arrow { display: none; }
  }
  @media (max-width: 640px) {
    #blog { padding: 4rem 0 !important; }
    .sec-head { flex-direction: column; gap: 0.5rem; margin-bottom: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-row, .post-row .arrow { transition: none; }
    .post-row:hover { padding-left: 0; }
    .post-row:hover .arrow { transform: none; }
  }
</style>
