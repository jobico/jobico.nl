<script>
  import 'vanilla-cookieconsent/dist/cookieconsent.css';
  import * as CookieConsent from 'vanilla-cookieconsent';

  // Pass the current analytics choice to Microsoft Clarity. When granted,
  // Clarity upgrades from cookieless mode to full tracking; when denied it
  // deletes its cookies and drops back to no-consent mode.
  function syncClarityConsent() {
    if (typeof window.clarity !== 'function') return;
    const granted = CookieConsent.acceptedCategory('analytics');
    window.clarity('consentv2', {
      ad_Storage: 'denied',
      analytics_Storage: granted ? 'granted' : 'denied',
    });
  }

  CookieConsent.run({
    categories: {
      necessary: {
        enabled: true,
        readOnly: true,
      },
      analytics: {},
    },

    // Fires on every page load once a choice exists, and on first consent.
    onConsent: syncClarityConsent,
    // Fires when the visitor later changes their preferences.
    onChange: syncClarityConsent,

    language: {
      default: 'en',
      translations: {
        en: {
          consentModal: {
            title: 'This site respects your privacy',
            description:
              'We use Microsoft Clarity to understand how the site is used. Until you accept, it runs in a cookieless mode that collects only anonymous, aggregated data. Accepting analytics enables session insights and heatmaps. You can review and update your preferences at any time.',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Necessary only',
            showPreferencesBtn: 'Manage preferences',
            footer: '<a href="/privacy-policy">Privacy Policy</a>',
          },
          preferencesModal: {
            title: 'Cookie preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Necessary only',
            savePreferencesBtn: 'Save preferences',
            sections: [
              {
                title: 'How we use cookies',
                description:
                  'This site is built to be as privacy-friendly as possible. We self-host all fonts and use only Microsoft Clarity for analytics, which stays cookieless until you consent. The sections below show exactly what is in use.',
              },
              {
                title: 'Strictly necessary',
                description:
                  'Required for the site to function. No personal data is collected.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytics',
                description:
                  'Microsoft Clarity helps us understand how visitors use the site through aggregated metrics, session recordings and heatmaps. Before you consent it runs in a cookieless mode with no persistent identifier. Accepting this category lets Clarity set its cookies (_clck, _clsk) and link your visit into a session so these features work fully.',
                linkedCategory: 'analytics',
                cookieTable: {
                  headers: {
                    name: 'Cookie',
                    domain: 'Domain',
                    description: 'Description',
                    expiration: 'Expiration',
                  },
                  body: [
                    {
                      name: '_clck',
                      domain: 'jobico.nl',
                      description:
                        'Microsoft Clarity — persists a Clarity user ID and preferences across visits.',
                      expiration: '1 year',
                    },
                    {
                      name: '_clsk',
                      domain: 'jobico.nl',
                      description:
                        'Microsoft Clarity — connects multiple page views into a single session recording.',
                      expiration: '1 day',
                    },
                  ],
                },
              },
              {
                title: 'More information',
                description:
                  'For any questions about our cookie policy, please <a href="/#contact">get in touch</a>.',
              },
            ],
          },
        },
      },
    },
  });
</script>

<style is:global>
  :root {
    --cc-bg: #ffffff;
    --cc-primary-color: #0A2E50;
    --cc-secondary-color: #4A6480;
    --cc-btn-primary-bg: #1C7CD5;
    --cc-btn-primary-color: #ffffff;
    --cc-btn-primary-hover-bg: #0A2E50;
    --cc-btn-secondary-bg: var(--cc-bg);
    --cc-btn-secondary-color: var(--cc-primary-color);
    --cc-btn-secondary-hover-bg: #e2eaf3;
    --cc-cookie-category-block-bg: #F4F8FC;
    --cc-cookie-category-block-border: #e2eaf3;
    --cc-cookie-category-block-hover-bg: #e8f0f8;
    --cc-cookie-category-block-hover-border: #1C7CD5;
    --cc-cookie-category-expanded-block-bg: #F4F8FC;
    --cc-toggle-on-bg: #1C7CD5;
    --cc-toggle-off-bg: #cbd5e1;
    --cc-toggle-readonly-bg: #B2EBF2;
    --cc-separator-border-color: #e2eaf3;
    --cc-footer-border-color: #e2eaf3;
    --cc-footer-bg: #F4F8FC;
    --cc-overlay-bg: rgba(10, 46, 80, 0.5);
    --cc-modal-border-radius: 0.75rem;
    --cc-btn-border-radius: 0.4rem;
    --cc-font-family: 'Montserrat Variable', system-ui, sans-serif;
  }
</style>
