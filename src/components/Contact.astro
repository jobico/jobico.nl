---
---
<section id="contact" style="padding: 6rem 0;">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 2rem;">

    <p class="kicker reveal" style="display: block; margin-bottom: 1.6rem;">Available for assignments</p>
    <h2 class="contact-head reveal reveal-delay-1">
      Let's fix what's broken.<br/>Then automate it.
    </h2>

    <div class="contact-grid">

      <!-- Left: info -->
      <div class="reveal reveal-delay-2">
        <div style="display: flex; flex-direction: column; gap: 1.75rem;">
          <div>
            <p class="contact-label">Email</p>
            <a href="mailto:info@jobico.nl" class="contact-mail">info@jobico.nl</a>
          </div>
          <div>
            <p class="contact-label">Location</p>
            <p style="color: var(--color-prussian); font-weight: 400; line-height: 1.6;">Mars 5, 5482 SN Schijndel<br/>Noord-Brabant, Nederland</p>
          </div>
          <div>
            <p class="contact-label">Company</p>
            <p style="color: var(--color-prussian); font-weight: 400;">JOBICO B.V.</p>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal reveal-delay-2">
        <form
          action="https://formspree.io/f/xnjwwdro"
          method="POST"
          style="display: flex; flex-direction: column; gap: 1.25rem;"
          id="contact-form"
        >
          <div class="form-name-email" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" class="form-input" />
            </div>
            <div>
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required placeholder="you@company.com" class="form-input" />
            </div>
          </div>

          <div>
            <label for="company" class="form-label">Company <span style="color: var(--color-shadow-soft);">(optional)</span></label>
            <input type="text" id="company" name="company" placeholder="Your company name" class="form-input" />
          </div>

          <div>
            <label for="subject" class="form-label">Subject</label>
            <input type="text" id="subject" name="subject" required placeholder="What is your question about?" class="form-input" />
          </div>

          <div>
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" required rows="5" placeholder="Describe your question or engagement..." class="form-input" style="resize: vertical; min-height: 140px;"></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center;">
            Send message
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <p style="font-size: 0.78rem; color: var(--color-shadow-soft); text-align: center; line-height: 1.5;">
            Your details are used solely to respond to your enquiry.
          </p>
        </form>

        <div id="form-success" style="display: none; background: #f0faf0; border: 1px solid var(--color-green); border-radius: 0.75rem; padding: 2rem; text-align: center;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="1.5" style="margin: 0 auto 1rem;"><polyline points="20 6 9 17 4 12"/></svg>
          <h3 style="margin-bottom: 0.5rem;">Message sent!</h3>
          <p style="color: var(--color-slate); font-size: 0.9rem;">Thanks for reaching out. I will get back to you as soon as possible.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
    if (res.ok) {
      form.style.display = 'none';
      if (success) success.style.display = 'block';
    }
  });
</script>

<style>
  .contact-head {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: 3.5rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
    align-items: start;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-hair);
  }
  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-shadow);
    margin-bottom: 0.5rem;
  }
  .contact-mail {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    letter-spacing: -0.02em;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 2px solid var(--color-aero);
    padding-bottom: 0.1em;
    transition: border-color 0.2s;
  }
  .contact-mail:hover { border-color: var(--color-navy); }
  .form-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-shadow);
    display: block;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 480px) {
    .form-name-email { grid-template-columns: 1fr !important; }
    #contact { padding: 4rem 0 !important; }
  }
</style>
