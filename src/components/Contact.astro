---
---
<section id="contact" style="padding: 7rem 1.5rem; background: white;">
  <div style="max-width: 1100px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start;">

      <!-- Left: info -->
      <div>
        <p class="section-label reveal" style="margin-bottom: 1.5rem;">Contact</p>
        <h2 class="reveal reveal-delay-1" style="font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; margin-bottom: 1.25rem;">
          Got a problem?<br/><span style="color: var(--color-navy);">Let's fix it.</span>
        </h2>
        <p class="reveal reveal-delay-2" style="line-height: 1.8; margin-bottom: 2.5rem;">
          Reach out for a direct, no-obligation conversation about your project or challenge.
        </p>

        <div class="reveal reveal-delay-3" style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 2.75rem; height: 2.75rem; background: var(--color-blizzard); border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <p style="font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); margin-bottom: 0.2rem;">Email</p>
              <a href="mailto:info@jobico.nl" style="color: var(--color-navy); font-weight: 500; text-decoration: none;">info@jobico.nl</a>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 2.75rem; height: 2.75rem; background: var(--color-blizzard); border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p style="font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); margin-bottom: 0.2rem;">Location</p>
              <p style="color: var(--color-prussian); font-weight: 500; line-height: 1.6;">Mars 5, 5482 SN Schijndel<br/>Noord-Brabant, Nederland</p>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 2.75rem; height: 2.75rem; background: var(--color-blizzard); border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C7CD5" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <div>
              <p style="font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); margin-bottom: 0.2rem;">Company</p>
              <p style="color: var(--color-prussian); font-weight: 500;">JOBICO B.V.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal reveal-delay-2">
        <form
          action="https://formspree.io/f/xnjwwdro"
          method="POST"
          style="display: flex; flex-direction: column; gap: 1.25rem;"
          id="contact-form"
        >
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label for="name" style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--color-prussian); display: block; margin-bottom: 0.4rem;">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" class="form-input" />
            </div>
            <div>
              <label for="email" style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--color-prussian); display: block; margin-bottom: 0.4rem;">Email</label>
              <input type="email" id="email" name="email" required placeholder="you@company.com" class="form-input" />
            </div>
          </div>

          <div>
            <label for="company" style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--color-prussian); display: block; margin-bottom: 0.4rem;">Company <span style="color: var(--color-slate); font-weight: 400;">(optional)</span></label>
            <input type="text" id="company" name="company" placeholder="Your company name" class="form-input" />
          </div>

          <div>
            <label for="subject" style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--color-prussian); display: block; margin-bottom: 0.4rem;">Subject</label>
            <input type="text" id="subject" name="subject" required placeholder="What is your question about?" class="form-input" />
          </div>

          <div>
            <label for="message" style="font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--color-prussian); display: block; margin-bottom: 0.4rem;">Message</label>
            <textarea id="message" name="message" required rows="5" placeholder="Describe your question or engagement..." class="form-input" style="resize: vertical; min-height: 140px;"></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center;">
            Send message
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <p style="font-size: 0.78rem; color: #9ab0c4; text-align: center; line-height: 1.5;">
            Your details are used solely to respond to your enquiry.
          </p>
        </form>

        <div id="form-success" style="display: none; background: #f0faf0; border: 1px solid var(--color-green); border-radius: 0.75rem; padding: 2rem; text-align: center;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="1.5" style="margin: 0 auto 1rem;"><polyline points="20 6 9 17 4 12"/></svg>
          <h3 style="font-family: var(--font-display); color: var(--color-prussian); margin-bottom: 0.5rem;">Message sent!</h3>
          <p style="color: var(--color-slate); font-size: 0.9rem;">Thanks for reaching out. I will get back to you as soon as possible.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
    if (res.ok) {
      form.style.display = 'none';
      if (success) success.style.display = 'block';
    }
  });
</script>

<style>
  @media (max-width: 768px) {
    #contact > div > div {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
  }
</style>
