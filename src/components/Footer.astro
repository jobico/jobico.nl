---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 2rem;">

    <div class="footer-top">

      <!-- Brand + tagline -->
      <div style="max-width: 280px;">
        <img src="/full-logo-800.png" alt="JOBICO" style="height: 2rem; width: auto; margin-bottom: 1.25rem; filter: brightness(0) invert(1); opacity: 0.9;" />
        <p style="color: rgba(178,235,242,0.6); font-size: 0.875rem; line-height: 1.7;">
          Freelance IT consultancy specialising in EUC, Digital Workspace and Citrix. Based in Noord-Brabant, the Netherlands.
        </p>
      </div>

      <div style="display: flex; gap: 3rem; flex-wrap: wrap;">

        <!-- Navigation -->
        <div>
          <p class="footer-label">Navigation</p>
          <div style="display: flex; flex-direction: column; gap: 0.6rem;">
            <a href="/#services" class="footer-link">Services</a>
            <a href="/#about" class="footer-link">About</a>
            <a href="/#contact" class="footer-link">Contact</a>
            <a href="https://blog.j81.nl" target="_blank" rel="noopener" class="footer-link">Blog ↗</a>
          </div>
        </div>

        <!-- Business details -->
        <div>
          <p class="footer-label">Business details</p>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <p style="color: rgba(178,235,242,0.8); font-size: 0.875rem; font-weight: 500;">JOBICO B.V.</p>
            <p style="color: rgba(178,235,242,0.55); font-size: 0.8rem;">John Billekens Consultancy</p>
            <p style="color: rgba(178,235,242,0.6); font-size: 0.8rem; line-height: 1.5;">
              Mars 5<br/>
              5482 SN Schijndel<br/>
              Nederland
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.5rem;">
              <p style="color: rgba(178,235,242,0.5); font-size: 0.78rem;">
                <span class="footer-meta-key">KvK</span>&nbsp;&nbsp;99165589
              </p>
              <p style="color: rgba(178,235,242,0.5); font-size: 0.78rem;">
                <span class="footer-meta-key">BTW</span>&nbsp;&nbsp;NL868838366B01
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p style="color: rgba(178,235,242,0.35); font-size: 0.8rem;">
        &copy; {year} JOBICO B.V. All rights reserved.
        &nbsp;·&nbsp;
        <a href="/privacy-policy" class="footer-privacy">Privacy Policy</a>
      </p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-prussian);
    padding: 4rem 0 2rem;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(178,235,242,0.1);
  }
  .footer-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-shadow-soft);
    margin-bottom: 1rem;
  }
  .footer-link {
    color: rgba(178,235,242,0.7);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .footer-link:hover { color: var(--color-blizzard); }
  .footer-meta-key {
    font-family: var(--font-mono);
    color: var(--color-shadow-soft);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
  }
  .footer-privacy {
    color: rgba(178,235,242,0.35);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .footer-privacy:hover { color: rgba(178,235,242,0.6); }

  @media (max-width: 560px) {
    .site-footer { padding: 3rem 0 2rem; }
  }
</style>
